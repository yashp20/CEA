// Copy this file to Secrets.xcconfig (same directory) and fill in values.
// Secrets.xcconfig is gitignored — never commit real keys.

// TODO(cea): your deployed /proxy Cloudflare Worker URL, e.g.
// CEA_PROXY_URL = https:/$()/cea-proxy.example.workers.dev
CEA_PROXY_URL =

// TODO(cea): Google Places API key (restrict by iOS bundle id com.cea.app).
CEA_PLACES_API_KEY =

// TODO(cea): your personal Zapier MCP server endpoint (mcp.zapier.com ->
// create an MCP server, connect your own apps, copy the server URL). This is
// user-owned: CEA only ever sees this endpoint, never app credentials.
CEA_ZAPIER_MCP_URL =
